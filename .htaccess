# Configuración para servidores Apache (la mayoría de hostings con cPanel).
# Si el servidor es Nginx, este archivo se ignora: ver INSTRUCCIONES-INFORMATICO.txt

# --- Dirección única: https://www.vaypatel.com ---
# Lleva http://, vaypatel.com (sin www) y cualquier otro nombre que apunte aquí a
# https://www.vaypatel.com con una redirección permanente (buena para Google).
# Activar (quitar las # de las 6 líneas siguientes) SOLO cuando el certificado SSL
# cubra vaypatel.com y www.vaypatel.com; si no, el navegador mostrará un aviso.
# RewriteEngine On
# RewriteCond %{HTTP_HOST} !^www\.vaypatel\.com$ [NC]
# RewriteRule ^ https://www.vaypatel.com%{REQUEST_URI} [L,R=301]
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://www.vaypatel.com%{REQUEST_URI} [L,R=301]

# Páginas de error con el diseño de la web

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html
DirectoryIndex index.php index.html
Options -Indexes

# Codificación
AddDefaultCharset UTF-8
AddCharset UTF-8 .json .html .css .txt

# Tipos de archivo modernos (fotos WebP y tipografías locales)
AddType image/webp .webp
AddType font/woff2 .woff2

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

# Caché: imágenes un mes; HTML y textos editables sin caché para que los cambios se vean al momento
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType text/html  "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# No mostrar estos archivos internos
<FilesMatch "^(LEEME\.txt|INSTRUCCIONES-INFORMATICO\.txt|.*\.tmp-.*)$">
  Require all denied
</FilesMatch>
